rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ─────────────────────────────────────────────────────

    /** The requesting user is the agency admin for the given agencyId. */
    function isAgencyAdmin(agencyId) {
      return request.auth != null && request.auth.uid == agencyId;
    }

    /** The requesting user is an active HR staff member of the given agency. */
    function isActiveHrStaff(agencyId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/hrStaff/$(request.auth.uid))
        && get(/databases/$(database)/documents/hrStaff/$(request.auth.uid)).data.agencyId == agencyId
        && get(/databases/$(database)/documents/hrStaff/$(request.auth.uid)).data.status == 'active';
    }

    /** Either agency admin or active HR staff. */
    function hasAgencyAccess(agencyId) {
      return isAgencyAdmin(agencyId) || isActiveHrStaff(agencyId);
    }

    // ─── agencies ─────────────────────────────────────────────────────────────

    match /agencies/{agencyId} {
      allow get:    if request.auth != null
                      && (request.auth.uid == agencyId || isActiveHrStaff(agencyId));
      allow create, update: if request.auth.uid == agencyId;
      allow delete: if false;
    }

    // ─── agencyModuleAccess ───────────────────────────────────────────────────

    match /agencyModuleAccess/{agencyId} {
      allow get:   if hasAgencyAccess(agencyId);
      allow write: if false;
    }

    // ─── hrStaff ──────────────────────────────────────────────────────────────

    match /hrStaff/{staffId} {
      allow get:    if request.auth != null
                      && (request.auth.uid == staffId
                          || isAgencyAdmin(resource.data.agencyId));
      allow list:   if request.auth != null
                      && isAgencyAdmin(request.query.filters["agencyId"].value);
      allow create: if request.auth.uid == staffId
                      || isAgencyAdmin(request.resource.data.agencyId);
      allow update: if isAgencyAdmin(resource.data.agencyId)
                      || request.auth.uid == staffId;
      allow delete: if isAgencyAdmin(resource.data.agencyId);
    }

    // ─── guards ───────────────────────────────────────────────────────────────

    match /guards/{guardId} {
      allow get:    if request.auth != null
                      && (request.auth.uid == guardId
                          || hasAgencyAccess(resource.data.agencyId));
      allow list:   if request.auth != null;
      allow create: if request.auth.uid == guardId
                      || hasAgencyAccess(request.resource.data.agencyId);
      allow update: if hasAgencyAccess(resource.data.agencyId)
                      || request.auth.uid == guardId;
      allow delete: if isAgencyAdmin(resource.data.agencyId);
    }

    // ─── sites ────────────────────────────────────────────────────────────────

    match /sites/{siteId} {
      allow get:           if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:          if request.auth != null;
      allow create:        if hasAgencyAccess(request.resource.data.agencyId);
      allow update, delete: if isAgencyAdmin(resource.data.agencyId);
    }

    // ─── branches ─────────────────────────────────────────────────────────────

    match /branches/{branchId} {
      allow get:           if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:          if request.auth != null;
      allow create:        if hasAgencyAccess(request.resource.data.agencyId);
      allow update, delete: if isAgencyAdmin(resource.data.agencyId);
    }

    // ─── inventoryItems ───────────────────────────────────────────────────────

    match /inventoryItems/{itemId} {
      allow get:    if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:   if request.auth != null;
      allow create: if isAgencyAdmin(request.resource.data.agencyId);
      // Admin full update; HR may only adjust assignedStock/status when issuing to guards
      allow update: if isAgencyAdmin(resource.data.agencyId)
                      || (hasAgencyAccess(resource.data.agencyId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['assignedStock', 'status', 'updatedAt']));
      allow delete: if isAgencyAdmin(resource.data.agencyId);
    }

    // ─── branchStock ──────────────────────────────────────────────────────────

    match /branchStock/{stockId} {
      // resource == null when the document doesn't exist yet (first allocation)
      allow get:    if request.auth != null
                      && (resource == null || hasAgencyAccess(resource.data.agencyId));
      allow list:   if request.auth != null;
      allow create: if hasAgencyAccess(request.resource.data.agencyId);
      allow update: if hasAgencyAccess(resource.data.agencyId);
      allow delete: if isAgencyAdmin(resource.data.agencyId);
    }

    // ─── guardInventoryAssignments ────────────────────────────────────────────

    match /guardInventoryAssignments/{assignmentId} {
      allow get:           if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:          if request.auth != null;
      allow create:        if hasAgencyAccess(request.resource.data.agencyId);
      allow update, delete: if hasAgencyAccess(resource.data.agencyId);
    }

    // ─── attendanceRecords ────────────────────────────────────────────────────

    match /attendanceRecords/{recordId} {
      allow get:           if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:          if request.auth != null;
      allow create:        if request.auth != null;
      allow update, delete: if hasAgencyAccess(resource.data.agencyId);
    }

    // ─── leaveRequests ────────────────────────────────────────────────────────

    match /leaveRequests/{reqId} {
      allow get:           if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:          if request.auth != null;
      allow create:        if request.auth != null;
      allow update, delete: if hasAgencyAccess(resource.data.agencyId);
    }

    // ─── reliefRequests ───────────────────────────────────────────────────────

    match /reliefRequests/{reqId} {
      allow get:           if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:          if request.auth != null;
      allow create:        if request.auth != null;
      allow update, delete: if hasAgencyAccess(resource.data.agencyId);
    }

    // ─── shiftAssignments ─────────────────────────────────────────────────────

    match /shiftAssignments/{shiftId} {
      allow get:           if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:          if request.auth != null;
      allow create:        if hasAgencyAccess(request.resource.data.agencyId);
      allow update, delete: if hasAgencyAccess(resource.data.agencyId);
    }

    // ─── formSchemas ──────────────────────────────────────────────────────────

    match /formSchemas/{schemaId} {
      allow get:    if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:   if request.auth != null;
      allow create, update, delete: if isAgencyAdmin(resource.data.agencyId)
                                       || isAgencyAdmin(request.resource.data.agencyId);
    }

    // ─── agencyFormBuilderFeatures ────────────────────────────────────────────

    match /agencyFormBuilderFeatures/{featureId} {
      allow get:   if request.auth != null;
      allow list:  if request.auth != null;
      allow write: if false;
    }

    // ─── prospectClients ──────────────────────────────────────────────────────

    match /prospectClients/{clientId} {
      allow get:           if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:          if request.auth != null;
      allow create:        if hasAgencyAccess(request.resource.data.agencyId);
      allow update, delete: if hasAgencyAccess(resource.data.agencyId);
    }

    // ─── prospectGuards ───────────────────────────────────────────────────────

    match /prospectGuards/{pgId} {
      allow get:           if request.auth != null && hasAgencyAccess(resource.data.agencyId);
      allow list:          if request.auth != null;
      allow create:        if hasAgencyAccess(request.resource.data.agencyId);
      allow update, delete: if hasAgencyAccess(resource.data.agencyId);
    }

    // ─── guardLoginOtps ───────────────────────────────────────────────────────

    match /guardLoginOtps/{otpId} {
      allow read, write: if request.auth != null;
    }

    // ─── guardPushTokens / guardNotifications ─────────────────────────────────

    match /guardPushTokens/{tokenId} {
      allow read, write: if request.auth != null;
    }

    match /guardNotifications/{notifId} {
      allow get:   if request.auth != null;
      allow write: if false;
    }

    // ─── Catch-all: deny everything else ─────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
