FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Production panel Hosting origins (also hard-coded in core/Firebase/panelOrigins.ts)
# FRONTEND_SUPER_ADMIN_URL=https://app-raksha-super-admin.web.app
# FRONTEND_AGENCY_ADMIN_URL=https://app-raksha-agency-admin.web.app
# FRONTEND_HR_URL=https://app-raksha-hr.web.app

# Cloud Run backends (asia-south1)
# ADMIN_API_URL=https://raskha-admin-api-csz7pz4xsq-el.a.run.app
# HR_API_URL=https://raskha-hr-api-csz7pz4xsq-el.a.run.app
# Production Super Admin API (bake into Vite builds via VITE_SUPER_ADMIN_API_URL):
# SUPER_ADMIN_API_URL=https://raskha-super-admin-api-csz7pz4xsq-el.a.run.app
# Local Super Admin:
# SUPER_ADMIN_API_URL=http://localhost:3003
# Super Admin frontend (Vite) / Agency Admin verification
# Local Super Admin API (preferred for `npm run dev`):
# VITE_SUPER_ADMIN_API_URL=http://localhost:3003
# Production Cloud Run (used when VITE_SUPER_ADMIN_API_FORCE_REMOTE=true, or in production builds):
# VITE_SUPER_ADMIN_API_URL=https://raskha-super-admin-api-csz7pz4xsq-el.a.run.app
# VITE_SUPER_ADMIN_API_KEY=
# Set true only when local Vite must call Cloud Run instead of localhost:3003
# VITE_SUPER_ADMIN_API_FORCE_REMOTE=false

# Agency Admin / HR frontends → Admin API (form schemas, HR password updates)
# VITE_ADMIN_API_URL=http://localhost:3001
# VITE_ADMIN_API_FORCE_REMOTE=false
# Days of offline grace after a successful Raksha verify (Agency Admin login).
# Use a small value (e.g. 1) while testing; production default is 30.
# VITE_AGENCY_VERIFY_GRACE_DAYS=30

# Super Admin backend (Firebase Admin SDK + OTP delete)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# SUPER_ADMIN_API_KEY=
# SUPER_ADMIN_EMAILS=you@example.com
# SUPER_ADMIN_NOTIFY_EMAIL=you@example.com
# SUPER_ADMIN_OTP_DEBUG=true

# Guard App API (local Expo → Express)
# GUARD_APP_API_PORT=3005
# ATTENDANCE_DEMO_MODE=true
# Demo unlock only applies when the assigned site has no latitude/longitude.
# When site coords exist in Firestore, haversine matching always runs.
# GEOFENCE_DEFAULT_RADIUS_METERS=150
# GUARD_DEMO_ID=RKS-8842
# GUARD_DEMO_PASSWORD=demo1234
# GUARD_DEMO_PHONE=9876543210
# GUARD_DEMO_SITE_ID=5rSri9bhiI7AKVrAINts
# Return OTP in API response while SMS is not wired:
# GUARD_OTP_DEBUG=true
# Cap concurrent base64→Storage uploads per instance (~20 waves for 150-guard rush):
# SELFIE_UPLOAD_CONCURRENCY=20
# SELFIE_UPLOAD_MAX_WAIT_MS=45000
# Allow k6 multi-punch with X-Load-Test-Id (demo only; disable in real prod):
# LOAD_TEST_ALLOW_MULTI_PUNCH=true
# Expo app API URL — Cloud Run or local LAN IP (not localhost on a physical phone).
# Copy to Panels/Guard Panel/Guard App/frontend/.env
# EXPO_PUBLIC_GUARD_API_URL=https://raskha-guard-app-api-csz7pz4xsq-el.a.run.app
# EXPO_PUBLIC_GUARD_API_URL=http://192.168.1.6:3005


# Extra CORS origins for backends (comma-separated), in addition to the panel URLs above
# CORS_ALLOWED_ORIGINS=

# Firebase Console → Authentication → Settings → Authorized domains must include:
#   app-raksha-super-admin.web.app
#   app-raksha-agency-admin.web.app
#   app-raksha-hr.web.app

# FIREBASE_STORAGE_BUCKET=app-raksha.firebasestorage.app
#
# Storage rules + CORS live in storage.rules / storage.cors.json
# Deploy rules:  firebase deploy --only storage
# Apply CORS:    gcloud storage buckets update gs://app-raksha.firebasestorage.app --cors-file=storage.cors.json
